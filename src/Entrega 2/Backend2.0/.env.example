# Use uma chave longa e aleatória no arquivo .env local.
JWT_SECRET=troque-esta-chave-por-uma-chave-longa-e-aleatoria

# Preencha apenas para executar npm run seed:admin (senha com no minimo 12 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: caminho do banco. Caminhos relativos partem do diretorio de execucao.
# Padrao: database/proxima_etapa.db. Use o mesmo caminho no init, migrate e start.
DB_PATH=
