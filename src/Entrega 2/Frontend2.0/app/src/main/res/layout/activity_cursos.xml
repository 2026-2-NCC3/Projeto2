<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fundo">

    <!-- Cabeçalho e filtros: os dados continuam sendo carregados pela DataListActivity. -->
    <LinearLayout
        android:id="@+id/dataHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dataTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cursos"
                android:textColor="@color/texto_primario"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/courseFilterButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="@drawable/bg_nav_item_ativo"
                android:src="@drawable/course_ic_filter"
                android:contentDescription="Abrir filtros, atualizar e sair"
                app:tint="@color/acao_primaria" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            android:text="Descubra oportunidades para aprender e crescer."
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/course_search_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/course_ic_search"
                android:importantForAccessibility="no"
                app:tint="#A69AB5" />

            <EditText
                android:id="@+id/courseSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Buscar cursos..."
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/texto_primario"
                android:textColorHint="#A69AB5"
                android:textSize="14sp"
                android:padding="0dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:fillViewport="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/courseTabTodos"
                    style="@style/CourseFilterChip"
                    android:background="@drawable/bg_tab_selecionada"
                    android:textColor="@color/fundo_card"
                    android:text="Todos" />

                <TextView
                    android:id="@+id/courseTabInscritos"
                    style="@style/CourseFilterChip"
                    android:text="Inscritos" />

                <TextView
                    android:id="@+id/courseTabTecnologia"
                    style="@style/CourseFilterChip"
                    android:text="Tecnologia" />

                <TextView
                    android:id="@+id/courseTabCarreira"
                    style="@style/CourseFilterChip"
                    android:text="Carreira" />

                <TextView
                    android:id="@+id/courseTabConcluidos"
                    style="@style/CourseFilterChip"
                    android:text="Concluídos" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="25dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/coursesSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cursos disponíveis"
                android:textColor="@color/texto_primario"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coursesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 cursos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="20dp"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:accessibilityLiveRegion="polite" />

            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- A DataListActivity exige essas Views. O menu superior mantém as ações acessíveis. -->
        <View
            android:id="@+id/dataRetry"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/dataLogout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/dataHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/dataItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navInicio"
            style="@style/CourseBottomItem"
            android:contentDescription="Ir para Início">
            <androidx.appcompat.widget.AppCompatImageView
                style="@style/CourseBottomIcon"
                android:src="@drawable/ic_home"
                app:tint="@color/texto_secundario" />
            <TextView style="@style/CourseBottomLabel" android:text="Início" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCursos"
            style="@style/CourseBottomItem"
            android:contentDescription="Cursos, tela atual">
            <androidx.appcompat.widget.AppCompatImageView
                style="@style/CourseBottomIcon"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/acao_primaria" />
            <TextView style="@style/CourseBottomLabel"
                android:text="Cursos"
                android:textStyle="bold"
                android:textColor="@color/acao_primaria" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAgenda"
            style="@style/CourseBottomItem"
            android:contentDescription="Ir para Agenda">
            <androidx.appcompat.widget.AppCompatImageView
                style="@style/CourseBottomIcon"
                android:src="@drawable/ic_calendar"
                app:tint="@color/texto_secundario" />
            <TextView style="@style/CourseBottomLabel" android:text="Agenda" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            style="@style/CourseBottomItem"
            android:contentDescription="Ir para Perfil">
            <androidx.appcompat.widget.AppCompatImageView
                style="@style/CourseBottomIcon"
                android:src="@drawable/ic_person"
                app:tint="@color/texto_secundario" />
            <TextView style="@style/CourseBottomLabel" android:text="Perfil" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
