<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        android:padding="@dimen/padding_tela_interna"
        android:text="Meus Cursos"
        android:textColor="@color/texto_primario"
        android:textSize="@dimen/texto_titulo_tela"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/tabsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_tela_interna"
        android:layout_marginTop="@dimen/espacamento_card"
        android:background="@drawable/bg_input_field"
        android:orientation="horizontal"
        android:padding="@dimen/espacamento_xxs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo">

        <TextView
            android:id="@+id/tabTodos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_card"
            android:paddingVertical="@dimen/espacamento_sm"
            android:text="Todos"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_rotulo" />

        <TextView
            android:id="@+id/tabEmAndamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_selecionada"
            android:paddingHorizontal="@dimen/padding_card"
            android:paddingVertical="@dimen/espacamento_sm"
            android:text="Em Andamento"
            android:textColor="@color/fundo_card"
            android:textSize="@dimen/texto_rotulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabConcluidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_card"
            android:paddingVertical="@dimen/espacamento_sm"
            android:text="Concluídos"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_rotulo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espacamento_sm"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_tela_interna">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preparatório ENEM - Redação"
                    android:textColor="@color/texto_primario"
                    android:textSize="@dimen/texto_titulo_card"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="40h • FECAP Liberdade"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_rotulo" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/espacamento_xxs"
                    android:layout_marginTop="@dimen/espacamento_card"
                    android:progress="65"
                    android:progressDrawable="@drawable/bg_progress_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:background="@drawable/bg_badge_verde"
                    android:paddingHorizontal="@dimen/espacamento_sm"
                    android:paddingVertical="@dimen/espacamento_xxs"
                    android:text="Em andamento"
                    android:textColor="@color/acao_primaria"
                    android:textSize="@dimen/texto_rotulo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_card"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inglês Instrumental"
                    android:textColor="@color/texto_primario"
                    android:textSize="@dimen/texto_titulo_card"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="40h • FECAP Liberdade"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_rotulo" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/espacamento_xxs"
                    android:layout_marginTop="@dimen/espacamento_card"
                    android:progress="30"
                    android:progressDrawable="@drawable/bg_progress_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:background="@drawable/bg_badge_verde"
                    android:paddingHorizontal="@dimen/espacamento_sm"
                    android:paddingVertical="@dimen/espacamento_xxs"
                    android:text="Em andamento"
                    android:textColor="@color/acao_primaria"
                    android:textSize="@dimen/texto_rotulo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_card"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matemática Básica"
                    android:textColor="@color/texto_primario"
                    android:textSize="@dimen/texto_titulo_card"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="40h • FECAP Liberdade"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_rotulo" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/espacamento_xxs"
                    android:layout_marginTop="@dimen/espacamento_card"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_progress_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:background="@drawable/bg_badge_verde"
                    android:paddingHorizontal="@dimen/espacamento_sm"
                    android:paddingVertical="@dimen/espacamento_xxs"
                    android:text="Concluído"
                    android:textColor="@color/acao_primaria"
                    android:textSize="@dimen/texto_rotulo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_navegacao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Início"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_home"
                app:tint="@color/texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:background="@drawable/bg_nav_item_ativo"
                android:contentDescription="Cursos"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/acao_primaria" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursos"
                android:textColor="@color/acao_primaria"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Agenda"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_calendar"
                app:tint="@color/texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Perfil"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_person"
                app:tint="@color/texto_secundario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
