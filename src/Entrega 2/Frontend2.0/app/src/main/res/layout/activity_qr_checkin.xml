<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="@color/fundo_principal">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/checkin_title" android:textSize="24sp"
        android:textColor="@color/texto_primario" />
    <TextView android:id="@+id/checkinStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingVertical="12dp"
        android:text="@string/checkin_ready" android:accessibilityLiveRegion="polite" />
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/checkinScanner" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone" />
    <ProgressBar android:id="@+id/checkinProgress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:visibility="gone" />
    <Button android:id="@+id/checkinScan" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/checkin_scan" />
    <Button android:id="@+id/checkinSettings" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/checkin_settings"
        android:visibility="gone" />
    <Button android:id="@+id/checkinHistory" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/checkin_history" />
    <Button android:id="@+id/checkinClose" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/checkin_close" />
</LinearLayout>
