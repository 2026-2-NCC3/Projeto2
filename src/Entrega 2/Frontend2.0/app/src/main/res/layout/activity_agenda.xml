<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fundo_principal">
    <ImageView
        android:id="@+id/agendaBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fundo"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <ScrollView
        android:id="@+id/agendaScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/agendaBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">
            <TextView
                android:id="@+id/dataTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="8dp"
                android:text="@string/agenda_title"
                android:fontFamily="sans-serif-black"
                android:textSize="27sp"
                android:textColor="@color/texto_primario"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/agendaMenu"
                app:layout_constraintTop_toTopOf="@id/agendaMenu"
                app:layout_constraintBottom_toBottomOf="@id/agendaMenu"
                />
            <ImageButton
                android:id="@+id/agendaMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="26dp"
                android:padding="14dp"
                android:background="@android:color/transparent"
                android:src="@drawable/agenda_more"
                app:tint="@color/texto_secundario"
                android:contentDescription="Mais opções"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <View
                android:id="@+id/dataLogout"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            <TextView
                android:id="@+id/agendaSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="4dp"
                android:text="@string/agenda_subtitle"
                android:textSize="15sp"
                android:textColor="@color/texto_secundario"
                app:layout_constraintTop_toBottomOf="@id/agendaMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <ImageButton
                android:id="@+id/btnMesAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/agenda_botao_mes"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/texto_primario"
                android:contentDescription="Mês anterior"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/agendaSubtitle"
                />
            <TextView
                android:id="@+id/txtMesAno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:textColor="@color/texto_primario"
                android:textStyle="bold"
                android:textSize="17sp"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="17sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintStart_toEndOf="@id/btnMesAnterior"
                app:layout_constraintEnd_toStartOf="@id/btnProximoMes"
                app:layout_constraintTop_toTopOf="@id/btnMesAnterior"
                app:layout_constraintBottom_toBottomOf="@id/btnMesAnterior"
                tools:text="Outubro 2024"
                />
            <ImageButton
                android:id="@+id/btnProximoMes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/agenda_botao_mes"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/texto_primario"
                android:contentDescription="Próximo mês"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnMesAnterior"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/agendaCalendarCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/agenda_calendario_card"
                android:elevation="2dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/btnMesAnterior"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.example.projetopi.AgendaCalendarGrid
                    android:id="@+id/gradeCalendario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:alignmentMode="alignMargins"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/agendaCommitmentsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="30dp"
                android:text="@string/agenda_commitments"
                android:fontFamily="sans-serif-black"
                android:textSize="22sp"
                android:textColor="@color/texto_primario"
                app:layout_constraintTop_toBottomOf="@id/agendaCalendarCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/txtDataSelecionada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="5dp"
                android:textSize="14sp"
                android:textColor="@color/texto_secundario"
                app:layout_constraintTop_toBottomOf="@id/agendaCommitmentsTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="25 de outubro"
                />
            <!-- Preservado como LinearLayout: AgendaActivity adiciona ações com LayoutParams ponderados. -->
            <com.example.projetopi.ConstraintStackLayout
                android:id="@+id/dataActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/txtDataSelecionada"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:tag="horizontal"
                />
            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/dataActions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:accessibilityLiveRegion="polite"
                app:layout_constraintTop_toBottomOf="@id/dataProgress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataRetry"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="12dp"
                android:text="@string/agenda_retry"
                android:textAllCaps="false"
                android:textColor="@color/acao_primaria"
                app:backgroundTint="@color/acao_suave"
                app:cornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/dataStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <com.example.projetopi.ConstraintStackLayout
                android:id="@+id/dataItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintTop_toBottomOf="@id/dataRetry"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/agendaBottomBar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/agenda_bottom_bar"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Início"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navCursos"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navInicioIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/navInicioText"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/navInicioText"
                style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_home"
                app:layout_constraintTop_toBottomOf="@id/navInicioIcon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navCursos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cursos"
            app:layout_constraintStart_toEndOf="@id/navInicio"
            app:layout_constraintEnd_toStartOf="@id/navAgenda"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navCursosIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/navCursosText"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/navCursosText"
                style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_courses"
                app:layout_constraintTop_toBottomOf="@id/navCursosIcon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Agenda, aba selecionada"
            app:layout_constraintStart_toEndOf="@id/navCursos"
            app:layout_constraintEnd_toStartOf="@id/navPerfil"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navAgendaIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/acao_primaria"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/navAgendaText"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/navAgendaText"
                style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_agenda"
                android:textColor="@color/acao_primaria"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/navAgendaIcon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Perfil"
            app:layout_constraintStart_toEndOf="@id/navAgenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/navPerfilIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/navPerfilText"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <TextView
                android:id="@+id/navPerfilText"
                style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_profile"
                app:layout_constraintTop_toBottomOf="@id/navPerfilIcon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
