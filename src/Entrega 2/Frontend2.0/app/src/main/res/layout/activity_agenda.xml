<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/fundo_principal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/agenda_fundo_organico"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dataTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/agenda_title"
                    android:fontFamily="sans-serif-black"
                    android:textSize="27sp"
                    android:textColor="@color/texto_primario" />

                <ImageButton
                    android:id="@+id/agendaMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/agenda_more"
                    app:tint="@color/texto_secundario"
                    android:contentDescription="Mais opções" />

                <!-- DataListActivity mantém a responsabilidade pelo logout. -->
                <View android:id="@+id/dataLogout"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/agenda_subtitle"
                android:textSize="15sp"
                android:textColor="@color/texto_secundario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp">

                <ImageButton
                    android:id="@+id/btnMesAnterior"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/agenda_botao_mes"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/texto_primario"
                    android:contentDescription="Mês anterior" />

                <TextView
                    android:id="@+id/txtMesAno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/texto_primario"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    tools:text="Outubro 2024" />

                <ImageButton
                    android:id="@+id/btnProximoMes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/agenda_botao_mes"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto_primario"
                    android:contentDescription="Próximo mês" />
            </LinearLayout>

            <!-- A grade é gerada por AgendaActivity conforme o mês real.
                 Uma única GridLayout substitui dezenas de TextViews estáticos. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/agenda_calendario_card"
                android:elevation="2dp"
                android:paddingHorizontal="10dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                android:orientation="vertical">

                <com.example.projetopi.AgendaCalendarGrid
                    android:id="@+id/gradeCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:alignmentMode="alignMargins"
                    tools:ignore="UselessParent" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/agenda_commitments"
                android:fontFamily="sans-serif-black"
                android:textSize="22sp"
                android:textColor="@color/texto_primario" />

            <TextView
                android:id="@+id/txtDataSelecionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:textSize="14sp"
                android:textColor="@color/texto_secundario"
                tools:text="25 de outubro" />

            <LinearLayout
                android:id="@+id/dataActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:layout_marginTop="15dp" />

            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataRetry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:layout_marginBottom="12dp"
                android:text="@string/agenda_retry"
                android:textAllCaps="false"
                android:textColor="@color/acao_primaria"
                app:backgroundTint="@color/acao_suave"
                app:cornerRadius="24dp" />

            <LinearLayout
                android:id="@+id/dataItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:background="@drawable/agenda_bottom_bar"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:id="@+id/navInicio"
            style="@style/Agenda.NavItem">
            <ImageView style="@style/Agenda.NavIcon"
                android:src="@drawable/ic_home"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null" />
            <TextView style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCursos"
            style="@style/Agenda.NavItem">
            <ImageView style="@style/Agenda.NavIcon"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null" />
            <TextView style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_courses" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAgenda"
            style="@style/Agenda.NavItem"
            android:contentDescription="Agenda, aba selecionada">
            <ImageView style="@style/Agenda.NavIcon"
                android:src="@drawable/ic_calendar"
                app:tint="@color/acao_primaria"
                android:contentDescription="@null" />
            <TextView style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_agenda"
                android:textColor="@color/acao_primaria"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            style="@style/Agenda.NavItem">
            <ImageView style="@style/Agenda.NavIcon"
                android:src="@drawable/ic_person"
                app:tint="@color/texto_secundario"
                android:contentDescription="@null" />
            <TextView style="@style/Agenda.NavText"
                android:text="@string/agenda_nav_profile" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
