<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Cadastro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Cabeçalho inspirado no protótipo aprovado -->
        <ImageButton
            android:id="@+id/btnVoltarCadastro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_input_field"
            android:contentDescription="Voltar para o login"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/texto_primario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtBemVindo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Criar sua conta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            app:layout_constraintStart_toEndOf="@id/btnVoltarCadastro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnVoltarCadastro"
            app:layout_constraintBottom_toBottomOf="@id/btnVoltarCadastro" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Preencha os dados para começar sua jornada."
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            app:layout_constraintTop_toBottomOf="@id/btnVoltarCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nome -->
        <TextView
            android:id="@+id/lblNomeCompleto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nome completo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:labelFor="@id/EditarNome"
            app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerNome"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintTop_toBottomOf="@id/lblNomeCompleto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person" />

            <EditText
                android:id="@+id/EditarNome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:padding="0dp"
                android:gravity="center_vertical"
                android:hint="Seu nome completo"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_secundario"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- E-mail -->
        <TextView
            android:id="@+id/lblEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="E-mail"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:labelFor="@id/EditarEmail"
            app:layout_constraintTop_toBottomOf="@id/containerNome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerEmailCadastro"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintTop_toBottomOf="@id/lblEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_email" />

            <EditText
                android:id="@+id/EditarEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:padding="0dp"
                android:gravity="center_vertical"
                android:hint="seuemail@exemplo.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_secundario"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- WhatsApp opcional: enviado à API como telefone apenas se preenchido -->
        <TextView
            android:id="@+id/lblWhatsapp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="WhatsApp (opcional)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:labelFor="@id/EditarWhatsapp"
            app:layout_constraintTop_toBottomOf="@id/containerEmailCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerWhatsapp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintTop_toBottomOf="@id/lblWhatsapp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_call"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/EditarWhatsapp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:padding="0dp"
                android:gravity="center_vertical"
                android:hint="(11) 99999-9999"
                android:inputType="phone"
                android:singleLine="true"
                android:maxLength="20"
                android:textSize="16sp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_secundario"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Senha -->
        <TextView
            android:id="@+id/lblSenha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Senha"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:labelFor="@id/EditSenha"
            app:layout_constraintTop_toBottomOf="@id/containerWhatsapp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerSenhaCadastro"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintTop_toBottomOf="@id/lblSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lock"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/EditSenha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:padding="0dp"
                android:gravity="center_vertical"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_secundario"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Confirmação usada apenas na validação local; não vai para a API -->
        <TextView
            android:id="@+id/lblConfirmarSenha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Confirmar senha"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:labelFor="@id/EditarConfirmarSenha"
            app:layout_constraintTop_toBottomOf="@id/containerSenhaCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerConfirmarSenha"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_field"
            app:layout_constraintTop_toBottomOf="@id/lblConfirmarSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lock"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/EditarConfirmarSenha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:padding="0dp"
                android:gravity="center_vertical"
                android:hint="Repita sua senha"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="@color/texto_primario"
                android:textColorHint="@color/texto_secundario"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Consentimento real, já utilizado pelo CadastroActivity.java -->
        <CheckBox
            android:id="@+id/checkConsentimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:checked="false"
            android:text="Concordo com a coleta do meu nome completo, e-mail, senha e, se informado, telefone para criar minha conta e autenticar meu acesso ao Próxima Etapa."
            android:textSize="13sp"
            android:textColor="@color/texto_secundario"
            android:buttonTint="@color/acao_primaria"
            app:layout_constraintTop_toBottomOf="@id/containerConfirmarSenha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ação principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/signup_submit"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/acao_primaria"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/checkConsentimento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Erro vindo do Java -->
        <TextView
            android:id="@+id/txtErroCadastro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/vermelho"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnCadastrar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtEntrar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Já tem uma conta? Entrar"
            android:textSize="14sp"
            android:textColor="@color/acao_primaria"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/txtErroCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
