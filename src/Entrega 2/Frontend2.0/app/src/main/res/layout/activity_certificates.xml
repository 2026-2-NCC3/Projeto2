<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/white" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/certificateBack" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_left"
            app:tint="@color/certificate_purple" android:contentDescription="@string/certificate_back" />
        <TextView android:id="@+id/dataTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/certificates_title" android:textSize="24sp"
            android:textStyle="bold" android:textColor="@color/certificate_ink" android:accessibilityHeading="true" />
        <ImageView android:layout_width="56dp" android:layout_height="48dp"
            android:src="@drawable/logo_proxima_etapa" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/certificates_intro" android:textColor="@color/certificate_muted"
                android:textSize="16sp" android:layout_marginBottom="20dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardBackgroundColor="@color/certificate_purple"
                app:cardCornerRadius="20dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/certificates_dedication" android:textSize="16sp" android:textColor="@color/white" />
                    <TextView android:id="@+id/certificateTotal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
                        android:textColor="@color/white" android:layout_marginTop="8dp" />
                    <View android:layout_width="48dp" android:layout_height="4dp"
                        android:background="@color/certificate_yellow" android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/dataStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingVertical="12dp"
                android:textColor="@color/certificate_muted" android:textSize="14sp"
                android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/dataProgress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:indeterminateTint="@color/certificate_purple" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/dataRetry"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/certificates_refresh" android:textAllCaps="false"
                android:textColor="@color/white" app:backgroundTint="@color/certificate_purple" app:cornerRadius="12dp" />
            <TextView android:id="@+id/certificateEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/certificates_empty"
                android:paddingVertical="24dp" android:textSize="16sp"
                android:textColor="@color/certificate_muted" android:visibility="gone" />
            <LinearLayout android:id="@+id/dataItems" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/certificate_soft" app:cardElevation="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16dp" android:text="@string/certificate_storage_notice"
                    android:textSize="14sp" android:textColor="@color/certificate_ink" />
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/certificate_offline_notice" android:textSize="14sp"
                android:textColor="@color/certificate_muted" android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
