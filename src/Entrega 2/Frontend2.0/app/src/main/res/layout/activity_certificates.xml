<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/certificateBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/certificate_back"
            app:tint="@color/certificate_purple" />
        <TextView
            android:id="@+id/dataTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/certificates_title"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/certificate_ink"
            android:accessibilityHeading="true" />
        <ImageView
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:src="@drawable/logo_proxima_etapa"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="22dp"
                android:text="@string/certificates_intro"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/certificate_muted" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/certificate_purple"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/certificates_dedication"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView
                            android:id="@+id/certificateTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/white" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/certificates_visual_motivation"
                            android:textSize="13sp"
                            android:textColor="@color/white" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="🏆"
                        android:textSize="44sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/certificates_visual_section"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/certificate_ink"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted"
                android:accessibilityLiveRegion="polite" />
            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/certificate_purple"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/dataItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/certificateEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="24dp"
                android:text="@string/certificates_empty"
                android:textSize="15sp"
                android:textColor="@color/certificate_muted"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="48dp"
                android:text="@string/certificates_refresh"
                android:textAllCaps="false"
                android:textColor="@color/certificate_purple"
                app:backgroundTint="@color/certificate_soft"
                app:cornerRadius="18dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/certificate_soft"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/certificates_visual_keepgoing"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/certificate_purple" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/certificates_visual_motivation"
                        android:textSize="14sp"
                        android:textColor="@color/certificate_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/certificate_storage_notice"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/certificate_offline_notice"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
