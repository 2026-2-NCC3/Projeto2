<?xml version="1.0" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/fundo">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:id="@+id/cl_activity_certificates_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cl_activity_certificates_15"
        app:layout_constraintVertical_chainStyle="spread">


        <ImageButton
            android:id="@+id/certificateBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/certificate_back"
            app:tint="@color/certificate_purple"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dataTitle"
            app:layout_constraintHorizontal_chainStyle="spread"/>


        <TextView
            android:id="@+id/dataTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/certificates_title"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="@color/certificate_ink"
            android:accessibilityHeading="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/certificateBack"
            app:layout_constraintEnd_toStartOf="@id/cl_activity_certificates_1"
            app:layout_constraintHorizontal_weight="1.0"/>


        <ImageView
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:src="@drawable/logo_proxima_etapa"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/cl_activity_certificates_1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/dataTitle"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:id="@+id/cl_activity_certificates_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1.0">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="22dp"
                android:text="@string/certificates_intro"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/certificate_muted"
                android:id="@+id/cl_activity_certificates_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/certificate_purple"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:id="@+id/cl_activity_certificates_9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_8">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/cl_activity_certificates_4"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cl_activity_certificates_5"
                        app:layout_constraintHorizontal_weight="1.0"
                        app:layout_constraintHorizontal_chainStyle="spread">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/certificates_dedication"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/cl_activity_certificates_2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>


                        <TextView
                            android:id="@+id/certificateTotal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="23sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/white"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_2"/>


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/certificates_visual_motivation"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:id="@+id/cl_activity_certificates_3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/certificateTotal"
                            app:layout_constraintBottom_toBottomOf="parent"/>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="🏆"
                        android:textSize="44sp"
                        android:importantForAccessibility="no"
                        android:id="@+id/cl_activity_certificates_5"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cl_activity_certificates_4"
                        app:layout_constraintEnd_toEndOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/certificates_visual_section"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/certificate_ink"
                android:accessibilityHeading="true"
                android:id="@+id/cl_activity_certificates_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_9"/>


            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted"
                android:accessibilityLiveRegion="polite"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_10"/>


            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/certificate_purple"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataStatus"/>


            <com.example.projetopi.ConstraintStackLayout
                android:id="@+id/dataItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataProgress"/>


            <TextView
                android:id="@+id/certificateEmpty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="24dp"
                android:text="@string/certificates_empty"
                android:textSize="15sp"
                android:textColor="@color/certificate_muted"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataItems"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="48dp"
                android:text="@string/certificates_refresh"
                android:textAllCaps="false"
                android:textColor="@color/certificate_purple"
                app:backgroundTint="@color/certificate_soft"
                app:cornerRadius="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/certificateEmpty"/>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/certificate_soft"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:id="@+id/cl_activity_certificates_11"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataRetry">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/certificates_visual_keepgoing"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/certificate_purple"
                        android:id="@+id/cl_activity_certificates_6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/certificates_visual_motivation"
                        android:textSize="14sp"
                        android:textColor="@color/certificate_muted"
                        android:id="@+id/cl_activity_certificates_7"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_6"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/certificate_storage_notice"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted"
                android:id="@+id/cl_activity_certificates_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_11"/>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/certificate_offline_notice"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/certificate_muted"
                android:id="@+id/cl_activity_certificates_13"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_certificates_12"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
