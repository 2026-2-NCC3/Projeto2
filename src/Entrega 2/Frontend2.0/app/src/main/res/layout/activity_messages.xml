<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:id="@+id/cl_activity_messages_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cl_activity_messages_7"
        app:layout_constraintVertical_chainStyle="spread"
        >
        <ImageButton
            android:id="@+id/messageBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/certificate_back"
            app:tint="@color/message_purple"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dataTitle"
            app:layout_constraintHorizontal_chainStyle="spread"
            />
        <TextView
            android:id="@+id/dataTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/messages_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/certificate_ink"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/messageBack"
            app:layout_constraintEnd_toStartOf="@id/cl_activity_messages_1"
            app:layout_constraintHorizontal_weight="1.0"
            />
        <ImageView
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_proxima_etapa"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/cl_activity_messages_1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/dataTitle"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/cl_activity_messages_7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_activity_messages_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1.0"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/messages_intro"
                android:textColor="@color/certificate_muted"
                android:textSize="16sp"
                android:id="@+id/cl_activity_messages_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/message_purple"
                app:cardElevation="0dp"
                android:id="@+id/cl_activity_messages_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_messages_3"
                >
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    >
                    <TextView
                        android:id="@+id/messageTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                    <View
                        android:layout_width="48dp"
                        android:layout_height="4dp"
                        android:background="@color/message_yellow"
                        android:layout_marginTop="12dp"
                        android:id="@+id/cl_activity_messages_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/messageTotal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/dataStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:textColor="@color/certificate_muted"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_messages_4"
                />
            <ProgressBar
                android:id="@+id/dataProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/message_purple"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataStatus"
                />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dataRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/messages_refresh"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/message_purple"
                app:cornerRadius="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataProgress"
                />
            <TextView
                android:id="@+id/messageEmpty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/messages_empty"
                android:textColor="@color/certificate_muted"
                android:textSize="16sp"
                android:paddingVertical="24dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataRetry"
                />
            <com.example.projetopi.ConstraintStackLayout
                android:id="@+id/dataItems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messageEmpty"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/messages_offline"
                android:textSize="14sp"
                android:textColor="@color/certificate_muted"
                android:id="@+id/cl_activity_messages_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dataItems"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
