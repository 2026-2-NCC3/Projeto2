<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo">
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Carteirinha Digital"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@color/white"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCertificados"/>
    <ImageButton
        android:id="@+id/btnCertificados"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_badge"
        android:padding="12dp"
        android:contentDescription="@string/certificates_title"
        app:tint="@color/certificate_purple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCarteirinha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="16dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gradiente_header"
                        android:padding="16dp"
                        android:id="@+id/cl_activity_carteiraestudante_7"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="82dp"
                            android:layout_height="46dp"
                            android:src="@drawable/logo_proxima_etapa"
                            android:scaleType="fitCenter"
                            android:background="@color/white"
                            android:padding="4dp"
                            android:importantForAccessibility="no"
                            android:id="@+id/cl_activity_carteiraestudante_1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carteirinha do Aluno"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_marginTop="2dp"
                            android:id="@+id/cl_activity_carteiraestudante_2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_1"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:id="@+id/cl_activity_carteiraestudante_8"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_7">
                        <FrameLayout
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_borda_foto_perfil"
                            android:padding="3dp"
                            android:id="@+id/cl_activity_carteiraestudante_3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/imgFotoAluno"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/student_card_avatar"
                                android:src="@drawable/ic_person"/>
                        </FrameLayout>
                        <TextView
                            android:id="@+id/txtNomeAluno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nome"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_primario"
                            android:layout_marginTop="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_3"/>
                        <TextView
                            android:id="@+id/txtRA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ID do aluno: --"
                            android:textColor="@color/texto_secundario"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtNomeAluno"/>
                        <ImageView
                            android:id="@+id/imgQrCode"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:contentDescription="@string/student_card_qr_unavailable"
                            android:visibility="gone"
                            android:layout_marginTop="18dp"
                            android:padding="@dimen/espacamento_sm"
                            android:src="@drawable/ic_qr_placeholder"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtRA"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_card_qr_unavailable"
                            android:textSize="11sp"
                            android:textColor="@color/texto_secundario"
                            android:layout_marginTop="8dp"
                            android:id="@+id/cl_activity_carteiraestudante_4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgQrCode"/>
                        <TextView
                            android:id="@+id/txtNomeCurso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_card_account"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_4"/>
                        <TextView
                            android:id="@+id/txtValidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_card_validity_unavailable"
                            android:textSize="11sp"
                            android:textColor="@color/texto_secundario"
                            android:layout_marginTop="2dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtNomeCurso"
                            app:layout_constraintBottom_toBottomOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@color/fundo_principal"
                        android:padding="10dp"
                        android:id="@+id/cl_activity_carteiraestudante_9"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_8"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_graduation_cap_small"
                            app:tint="@color/verde_azulado_escuro"
                            android:id="@+id/cl_activity_carteiraestudante_5"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/cl_activity_carteiraestudante_6"
                            app:layout_constraintHorizontal_chainStyle="packed"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Próxima Etapa · Educação para Todos"
                            android:textSize="10sp"
                            android:textColor="@color/texto_secundario"
                            android:layout_marginStart="6dp"
                            android:id="@+id/cl_activity_carteiraestudante_6"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/cl_activity_carteiraestudante_5"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerBotoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/cardCarteirinha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingBottom="16dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnCompartilhar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_botao_outline_verde"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnBaixarPdf"
                    app:layout_constraintHorizontal_weight="1.0"
                    app:layout_constraintHorizontal_chainStyle="spread">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/verde_azulado_escuro"
                        android:id="@+id/cl_activity_carteiraestudante_10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cl_activity_carteiraestudante_11"
                        app:layout_constraintHorizontal_chainStyle="packed"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Compartilhar"
                        android:textColor="@color/verde_azulado_escuro"
                        android:textSize="13sp"
                        android:id="@+id/cl_activity_carteiraestudante_11"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cl_activity_carteiraestudante_10"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnBaixarPdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_botao_outline_verde"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnCompartilhar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1.0">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/verde_azulado_escuro"
                        android:id="@+id/cl_activity_carteiraestudante_12"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cl_activity_carteiraestudante_13"
                        app:layout_constraintHorizontal_chainStyle="packed"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Baixar PDF"
                        android:textSize="13sp"
                        android:textColor="@color/verde_azulado_escuro"
                        android:layout_marginStart="8dp"
                        android:id="@+id/cl_activity_carteiraestudante_13"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cl_activity_carteiraestudante_12"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:paddingVertical="@dimen/padding_navegacao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navCursos"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintHorizontal_chainStyle="spread">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Início"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_home"
                app:tint="@color/texto_secundario"
                android:id="@+id/cl_activity_carteiraestudante_14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cl_activity_carteiraestudante_15"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape"
                android:id="@+id/cl_activity_carteiraestudante_15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_14"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navCursos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/navInicio"
            app:layout_constraintEnd_toStartOf="@id/navAgenda"
            app:layout_constraintHorizontal_weight="1.0">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Cursos"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/texto_secundario"
                android:id="@+id/cl_activity_carteiraestudante_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cl_activity_carteiraestudante_17"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursos"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape"
                android:id="@+id/cl_activity_carteiraestudante_17"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_16"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/navCursos"
            app:layout_constraintEnd_toStartOf="@id/navPerfil"
            app:layout_constraintHorizontal_weight="1.0">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Agenda"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_calendar"
                app:tint="@color/texto_secundario"
                android:id="@+id/cl_activity_carteiraestudante_18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cl_activity_carteiraestudante_19"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape"
                android:id="@+id/cl_activity_carteiraestudante_19"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_18"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/navAgenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1.0">
            <ImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:background="@drawable/bg_nav_item_ativo"
                android:contentDescription="Perfil"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_person"
                app:tint="@color/acao_primaria"
                android:id="@+id/cl_activity_carteiraestudante_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cl_activity_carteiraestudante_21"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/acao_primaria"
                android:textSize="@dimen/texto_rodape"
                android:id="@+id/cl_activity_carteiraestudante_21"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_carteiraestudante_20"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
