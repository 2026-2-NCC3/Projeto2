<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/fundo_principal" android:padding="16dp" android:fitsSystemWindows="true">
    <TextView android:id="@+id/dataTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/texto_primario"/>
    <TextView android:id="@+id/dataStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:accessibilityLiveRegion="polite"/>
    <ProgressBar android:id="@+id/dataProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
    <Button
        android:id="@+id/dataRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/acao_primaria"
        android:textColor="@color/white"
        android:text="Atualizar / tentar novamente" />
    <LinearLayout android:id="@+id/dataActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/dataItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/navInicio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inicio" android:textSize="11sp"/>
        <Button android:id="@+id/navCursos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cursos" android:textSize="11sp"/>
        <Button android:id="@+id/navAgenda" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Agenda" android:textSize="11sp"/>
        <Button android:id="@+id/navPerfil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Perfil" android:textSize="11sp"/>
    </LinearLayout>
    <Button android:id="@+id/dataLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sair"/>
</LinearLayout>
