<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        android:padding="@dimen/padding_tela_interna"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/cl_activity_paginainicial_2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cl_activity_paginainicial_3"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintHorizontal_chainStyle="spread">
            <TextView
                android:id="@+id/dashboardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_xxs"
                android:text="@string/dashboard_greeting"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_saudacao"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dashboardDate" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_xxs"
                android:text="@string/dashboard_welcome"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_subtitulo_app"
                android:id="@+id/cl_activity_paginainicial_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSaudacao"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacamento_xs"
            android:layout_marginEnd="@dimen/espacamento_xxs"
            android:id="@+id/cl_activity_paginainicial_3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cl_activity_paginainicial_2"
            app:layout_constraintEnd_toStartOf="@id/cl_activity_paginainicial_4">
            <ImageButton
                android:id="@+id/notificationButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications_title"
                android:src="@drawable/ic_notification"
                app:tint="@color/acao_primaria" />
            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:background="@color/certificate_purple"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingHorizontal="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/cl_activity_paginainicial_4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/cl_activity_paginainicial_3"
            app:layout_constraintEnd_toEndOf="parent">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgAvatar"
                android:layout_width="@dimen/tamanho_avatar"
                android:layout_height="@dimen/tamanho_avatar"
                android:contentDescription="@string/dashboard_profile"
                android:src="@drawable/foto_perfil"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/btnSair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/dashboard_sign_out"
                android:textColor="@color/acao_primaria"
                android:textSize="@dimen/texto_subtitulo_app"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgAvatar"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fundo_principal"
            android:padding="@dimen/padding_tela_interna">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_roxo"
                android:padding="20dp"
                android:id="@+id/cl_activity_paginainicial_22"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_hero_label"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:id="@+id/cl_activity_paginainicial_5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="@string/dashboard_hero_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:id="@+id/cl_activity_paginainicial_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_5" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="@string/dashboard_hero_description"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:id="@+id/cl_activity_paginainicial_7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_6" />
                <TextView
                    android:id="@+id/dashboardExplore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_md"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/padding_tela_interna"
                    android:text="@string/dashboard_explore"
                    android:textColor="@color/acao_primaria"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_7"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_lg"
                android:text="@string/dashboard_shortcuts"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_titulo_secao"
                android:textStyle="bold"
                android:id="@+id/cl_activity_paginainicial_23"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_22" />
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_sm"
                android:columnCount="2"
                android:rowCount="3"
                android:id="@+id/cl_activity_paginainicial_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_23">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/atalhoCursos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Meus cursos"
                        android:src="@drawable/ic_menu_book"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_8"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_9"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_courses"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_9"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_8"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/atalhoAgenda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Agenda"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_10"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_11"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_agenda"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_11"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_10"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/atalhoCarteirinha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Carteirinha"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_13"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="Carteirinha"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_13"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_12"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/atalhoMensagens"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="@string/messages_title"
                        android:src="@drawable/ic_email"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_14"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_15"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/messages_title"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_14"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dashboardCheckin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr_placeholder"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_17"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_checkin"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_17"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_16"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dashboardCertificates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:padding="@dimen/padding_card">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/acao_primaria"
                        android:id="@+id/cl_activity_paginainicial_18"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cl_activity_paginainicial_19"
                        app:layout_constraintVertical_chainStyle="packed" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_certificates"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:id="@+id/cl_activity_paginainicial_19"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_18"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </GridLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_lg"
                android:text="@string/dashboard_next_activity"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_titulo_secao"
                android:textStyle="bold"
                android:id="@+id/cl_activity_paginainicial_25"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_24" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_sm"
                android:background="@drawable/bg_card_branco"
                android:padding="@dimen/padding_card"
                android:id="@+id/cl_activity_paginainicial_26"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_activity_paginainicial_25"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_item_ativo"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/acao_primaria"
                    android:id="@+id/cl_activity_paginainicial_20"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cl_activity_paginainicial_21"
                    app:layout_constraintHorizontal_chainStyle="spread" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacamento_card"
                    android:accessibilityLiveRegion="polite"
                    android:id="@+id/cl_activity_paginainicial_21"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cl_activity_paginainicial_20"
                    app:layout_constraintEnd_toStartOf="@id/txtVerDetalhes"
                    app:layout_constraintHorizontal_weight="1.0">
                    <TextView
                        android:id="@+id/dashboardActivityTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_activity_loading"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_titulo_card"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/dashboardActivityDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_xxs"
                        android:textColor="@color/texto_secundario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dashboardActivityTitle"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/txtVerDetalhes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_open_agenda"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/acao_primaria"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cl_activity_paginainicial_21"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:paddingBottom="@dimen/padding_navegacao"
        android:paddingTop="@dimen/padding_navegacao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navCursos"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintHorizontal_chainStyle="spread">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:background="@drawable/bg_nav_item_ativo"
                android:contentDescription="Início"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_home"
                app:tint="@color/acao_primaria"
