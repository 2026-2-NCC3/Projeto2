<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/fundo_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/padding_tela_interna"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dashboardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />

            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_xxs"
                android:text="@string/dashboard_greeting"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_saudacao"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_xxs"
                android:text="@string/dashboard_welcome"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_subtitulo_app" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacamento_xs"
            android:layout_marginEnd="@dimen/espacamento_xxs">
            <ImageButton
                android:id="@+id/notificationButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications_title"
                android:src="@drawable/ic_notification"
                app:tint="@color/acao_primaria" />
            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:background="@color/certificate_purple"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingHorizontal="4dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgAvatar"
            android:layout_width="@dimen/tamanho_avatar"
            android:layout_height="@dimen/tamanho_avatar"
            android:contentDescription="@string/dashboard_profile"
            android:src="@drawable/foto_perfil" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fundo_principal"
            android:orientation="vertical"
            android:padding="@dimen/padding_tela_interna">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_roxo"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_hero_label"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="@string/dashboard_hero_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_sm"
                    android:text="@string/dashboard_hero_description"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/dashboardExplore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacamento_md"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/padding_tela_interna"
                    android:text="@string/dashboard_explore"
                    android:textColor="@color/acao_primaria"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_lg"
                android:text="@string/dashboard_shortcuts"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_titulo_secao"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_sm"
                android:columnCount="2"
                android:rowCount="3">

                <LinearLayout
                    android:id="@+id/atalhoCursos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Meus cursos"
                        android:src="@drawable/ic_menu_book"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_courses"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/atalhoAgenda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Agenda"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_agenda"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/atalhoCarteirinha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="Carteirinha"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="Carteirinha"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>

                <LinearLayout android:id="@+id/atalhoMensagens" android:clickable="true" android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:contentDescription="@string/messages_title"
                        android:src="@drawable/ic_email"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/messages_title"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardCheckin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr_placeholder"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_checkin"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardCertificates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/espacamento_entre_cards"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_card">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tamanho_icone_atalho"
                        android:layout_height="@dimen/tamanho_icone_atalho"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_badge"
                        app:tint="@color/acao_primaria" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_sm"
                        android:text="@string/dashboard_certificates"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_subtitulo_app" />
                </LinearLayout>
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_lg"
                android:text="@string/dashboard_next_activity"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_titulo_secao"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacamento_sm"
                android:background="@drawable/bg_card_branco"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_card">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_item_ativo"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/acao_primaria" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacamento_card"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dashboardActivityTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_activity_loading"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_titulo_card"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboardActivityDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacamento_xxs"
                        android:textColor="@color/texto_secundario"
                        android:textSize="@dimen/texto_subtitulo_app"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/txtVerDetalhes"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dashboard_open_agenda"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/acao_primaria" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/padding_navegacao"
        android:paddingTop="@dimen/padding_navegacao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:background="@drawable/bg_nav_item_ativo"
                android:contentDescription="Início"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_home"
                app:tint="@color/acao_primaria" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/acao_primaria"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCursos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Cursos"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_menu_book"
                app:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursos"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Agenda"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_calendar"
                app:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/tamanho_icone_nav"
                android:layout_height="@dimen/tamanho_icone_nav"
                android:contentDescription="Perfil"
                android:padding="@dimen/espacamento_xxs"
                android:src="@drawable/ic_person"
                app:tint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_rodape" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
