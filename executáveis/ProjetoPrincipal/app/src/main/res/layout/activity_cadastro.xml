<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/Cadastro"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="36dp"
    android:background="@color/white">

<ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:src="@drawable/logo_proxima_etapa"
        android:contentDescription="Logo Próxima Etapa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/txtBemVindo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comece sua jornada"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastre-se e acesse cursos gratuitos nas melhores universidades"
        android:textSize="14sp"
        android:textColor="@color/cinza"
        app:layout_constraintTop_toBottomOf="@id/txtBemVindo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblNomeCompleto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome Completo"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <EditText
        android:id="@+id/EditarNome"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Seu nome completo"
        android:inputType="textPersonName"
        android:paddingStart="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/lblNomeCompleto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
    android:id="@+id/lblEscola"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Nome da Escola"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintTop_toBottomOf="@+id/EditarNome"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="20dp" />
    <EditText
        android:id="@+id/EditarEscola"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="Nome da Escola"
        android:inputType="text"
        android:paddingStart="16dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/lblEscola"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/lblSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senha"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/EditarEscola"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <EditText
        android:id="@+id/editSenha"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="48dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/lblSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <ImageButton
        android:id="@+id/btnMostrarSenha"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_eye"
        android:contentDescription="Mostrar senha"
        app:layout_constraintEnd_toEndOf="@id/editSenha"
        app:layout_constraintTop_toTopOf="@id/editSenha"
        app:layout_constraintBottom_toBottomOf="@id/editSenha"
        android:layout_marginEnd="16dp" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Entrar ->"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/verde"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/editSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/txtEntrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Já tem uma conta? Entrar"
        android:textSize="14sp"
        android:textColor="@color/roxo"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/btnEntrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />
</androidx.constraintlayout.widget.ConstraintLayout>